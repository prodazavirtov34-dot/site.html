<!DOCTYPE html>
<html lang="ru" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>магахоствидео | Безопасный видео и фото хостинг</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          },
          colors: {
            brand: {
              red: '#FF2E54',
              redHover: '#e01c40',
              accent: '#00F5D4',
              dark: '#080A0F',
              surface: '#11141E',
              card: '#161A26',
              border: 'rgba(255, 255, 255, 0.08)'
            }
          }
        }
      }
    }
  </script>
  <style>
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #080A0F;
    }
    ::-webkit-scrollbar-thumb {
      background: #252B3B;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #FF2E54;
    }
    .glass-nav {
      background: rgba(8, 10, 15, 0.88);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
    .neon-text-gradient {
      background: linear-gradient(135deg, #FF2E54 0%, #FF5A79 50%, #9B51E0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .neon-glow-red {
      box-shadow: 0 0 25px -4px rgba(255, 46, 84, 0.4);
    }
    .media-card-aspect {
      aspect-ratio: 16 / 9;
    }
  </style>
</head>
<body class="bg-[#080A0F] text-gray-100 font-sans min-h-screen flex flex-col antialiased selection:bg-[#FF2E54] selection:text-white">

  <header class="sticky top-0 z-40 glass-nav border-b border-white/10 px-4 lg:px-8 py-3.5 transition-all">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <div class="flex items-center gap-3 cursor-pointer group" onclick="app.resetFeedFilter()">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#FF2E54] via-rose-600 to-purple-600 p-[2px] transition-transform duration-300 group-hover:scale-105 neon-glow-red">
          <div class="w-full h-full bg-[#080A0F] rounded-[10px] flex items-center justify-center">
            <i class="fa-solid fa-play text-[#FF2E54] text-base pl-0.5"></i>
          </div>
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1.5">
            <span class="text-xl font-extrabold tracking-tight neon-text-gradient uppercase leading-none">магахост<span class="text-white">видео</span></span>
            <span class="hidden sm:inline-flex items-center gap-1 px-1.5 py-0.5 text-[9px] uppercase font-mono tracking-widest bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 rounded-md font-bold">
              <i class="fa-solid fa-shield-halved text-[8px]"></i> Чистый
            </span>
          </div>
          <span class="text-[10px] text-gray-400 tracking-wider">хостинг без спама и 18+</span>
        </div>
      </div>

      <!-- Search Input -->
      <div class="flex-1 max-w-md hidden md:block relative">
        <div class="relative">
          <input 
            type="text" 
            id="searchInput" 
            placeholder="Поиск по публикациям, авторам или тегам..." 
            oninput="app.handleSearch(this.value)"
            class="w-full pl-11 pr-10 py-2.5 bg-[#11141E] border border-white/10 rounded-xl text-sm placeholder-gray-500 text-white focus:outline-none focus:border-[#FF2E54] focus:ring-1 focus:ring-[#FF2E54] transition shadow-inner"
          >
          <i class="fa-solid fa-magnifying-glass absolute left-4 top-3.5 text-gray-500 text-sm"></i>
          <button id="clearSearchBtn" onclick="app.clearSearch()" class="hidden absolute right-3.5 top-3 text-gray-400 hover:text-white text-xs">
            <i class="fa-solid fa-circle-xmark"></i>
          </button>
        </div>
      </div>

      <!-- Header Action Controls -->
      <div class="flex items-center gap-3">
        <button 
          onclick="app.openUploadModal()"
          class="flex items-center gap-2 px-4 py-2.5 bg-[#FF2E54] hover:bg-[#e01c40] text-white font-semibold rounded-xl text-sm transition-all transform active:scale-95 shadow-lg shadow-red-500/25"
        >
          <i class="fa-solid fa-cloud-arrow-up text-base"></i>
          <span class="hidden sm:inline">Загрузить с диска</span>
        </button>

        <div id="userHeaderBlock">
          <!-- Injected via JS -->
        </div>
      </div>

    </div>

    <!-- Mobile Search Bar -->
    <div class="mt-3 block md:hidden max-w-md mx-auto">
      <div class="relative">
        <input 
          type="text" 
          placeholder="Поиск материалов..." 
          oninput="app.handleSearch(this.value)"
          class="w-full pl-10 pr-4 py-2 bg-[#11141E] border border-white/10 rounded-xl text-xs text-white focus:outline-none focus:border-[#FF2E54]"
        >
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3 text-gray-500 text-xs"></i>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 lg:px-8 py-6">
    
    <!-- Info Banner (Moderation rules & storage indicator) -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-red-950/20 via-[#11141E] to-black/60 border border-white/10 p-4 sm:p-5 mb-6">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <h2 class="text-sm sm:text-base font-bold text-white">
              Локальный безопасный медиахостинг
            </h2>
          </div>
          <p class="text-xs text-gray-400 max-w-2xl">
            Все видео и фото сохраняются на вашем устройстве через IndexedDB. Действует встроенная анти-мат и анти-порно фильтрация: запрещены нецензурные слова, порнография и оскорбления.
          </p>
        </div>

        <div class="flex items-center gap-3 text-xs bg-black/40 border border-white/10 px-3.5 py-2 rounded-xl">
          <div>
            <span class="text-gray-400 block text-[10px] uppercase font-mono">Авторов</span>
            <span id="statAuthorsCount" class="font-bold text-emerald-400 font-mono">0</span>
          </div>
          <div class="h-6 w-[1px] bg-white/10"></div>
          <div>
            <span class="text-gray-400 block text-[10px] uppercase font-mono">Файлов в базе</span>
            <span id="statMediaCount" class="font-bold text-[#FF2E54] font-mono">0</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Category Filters -->
    <div class="flex items-center justify-between gap-3 overflow-x-auto pb-2 scrollbar-none mb-6">
      <div class="flex items-center gap-2">
        <button onclick="app.setFilter('all')" id="filter-all" class="category-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white text-black transition-all whitespace-nowrap shadow">
          <i class="fa-solid fa-layer-group mr-1.5 text-[#FF2E54]"></i> Все материалы
        </button>
        <button onclick="app.setFilter('video')" id="filter-video" class="category-btn px-4 py-2 rounded-xl text-xs font-semibold bg-[#161A26] hover:bg-[#1d2233] text-gray-300 border border-white/5 transition-all whitespace-nowrap">
          <i class="fa-solid fa-video mr-1.5 text-blue-400"></i> Видео
        </button>
        <button onclick="app.setFilter('image')" id="filter-image" class="category-btn px-4 py-2 rounded-xl text-xs font-semibold bg-[#161A26] hover:bg-[#1d2233] text-gray-300 border border-white/5 transition-all whitespace-nowrap">
          <i class="fa-solid fa-image mr-1.5 text-emerald-400"></i> Фото
        </button>
        <button onclick="app.setFilter('my')" id="filter-my" class="category-btn px-4 py-2 rounded-xl text-xs font-semibold bg-[#161A26] hover:bg-[#1d2233] text-gray-300 border border-white/5 transition-all whitespace-nowrap">
          <i class="fa-solid fa-user mr-1.5 text-purple-400"></i> Мои публикации
        </button>
      </div>

      <div class="text-[11px] text-gray-500 font-mono whitespace-nowrap hidden sm:block">
        <i class="fa-solid fa-database mr-1"></i> Хранилище: IndexedDB
      </div>
    </div>

    <!-- Media Grid Container -->
    <div id="mediaFeedGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Injected from IndexedDB -->
    </div>

    <!-- Empty State -->
    <div id="emptyState" class="hidden flex-col items-center justify-center py-20 text-center px-4">
      <div class="w-20 h-20 rounded-3xl bg-[#161A26] border border-white/10 flex items-center justify-center text-gray-500 text-3xl mb-4 shadow-xl">
        <i class="fa-solid fa-folder-open text-[#FF2E54]"></i>
      </div>
      <h3 class="text-lg font-bold text-white">Пока нет загруженных материалов</h3>
      <p class="text-xs sm:text-sm text-gray-400 max-w-md mt-1 mb-5">
        Платформа абсолютно чиста. Будьте первым, кто опубликует видео или фото с диска на магахоствидео!
      </p>
      <button onclick="app.openUploadModal()" class="px-5 py-2.5 bg-[#FF2E54] hover:bg-[#e01c40] text-white rounded-xl text-xs font-bold transition shadow-lg shadow-red-500/20 flex items-center gap-2">
        <i class="fa-solid fa-plus"></i> Опубликовать первый файл
      </button>
    </div>

  </main>

  <div id="uploadModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="bg-[#11141E] border border-white/15 w-full max-w-xl rounded-2xl p-6 shadow-2xl relative max-h-[92vh] overflow-y-auto">
      
      <button onclick="app.closeUploadModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-2 text-lg">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="flex items-center gap-3 mb-5">
        <div class="w-10 h-10 rounded-xl bg-red-500/15 text-[#FF2E54] flex items-center justify-center text-lg">
          <i class="fa-solid fa-cloud-arrow-up"></i>
        </div>
        <div>
          <h2 class="text-base sm:text-lg font-bold text-white">Загрузить медиафайл с диска</h2>
          <p class="text-xs text-gray-400">Поддерживаются видео (MP4, WebM) и фото (JPG, PNG, WEBP)</p>
        </div>
      </div>

      <!-- Drag & Drop Zone -->
      <div 
        id="dropZone"
        onclick="document.getElementById('fileInput').click()"
        class="border-2 border-dashed border-white/15 hover:border-[#FF2E54] bg-[#0A0D14] rounded-2xl p-6 text-center cursor-pointer transition-all mb-4 group"
      >
        <input 
          type="file" 
          id="fileInput" 
          accept="video/mp4,video/webm,image/jpeg,image/png,image/webp,image/gif" 
          class="hidden" 
          onchange="app.handleFileSelect(event)"
        >
        
        <div id="uploadPrompt" class="flex flex-col items-center">
          <div class="w-12 h-12 rounded-2xl bg-white/5 group-hover:bg-red-500/10 text-gray-400 group-hover:text-[#FF2E54] flex items-center justify-center text-xl mb-3 transition">
            <i class="fa-solid fa-file-arrow-up"></i>
          </div>
          <p class="text-sm font-semibold text-white">Нажмите для выбора файла с вашего диска</p>
          <p class="text-xs text-gray-500 mt-1">или перетащите видео/фото в эту область</p>
        </div>

        <!-- Preview Zone -->
        <div id="uploadPreviewZone" class="hidden relative rounded-xl overflow-hidden bg-black max-h-64 flex items-center justify-center">
          <img id="imagePreview" class="max-h-60 w-auto object-contain hidden" alt="Предпросмотр фото" />
          <video id="videoPreview" controls class="max-h-60 w-full hidden"></video>
          <button 
            type="button" 
            onclick="event.stopPropagation(); app.clearSelectedFile();" 
            class="absolute top-2 right-2 px-2.5 py-1 bg-red-600 text-white text-xs rounded-lg hover:bg-red-700 shadow"
          >
            Сменить
          </button>
        </div>
      </div>

      <!-- Form Inputs -->
      <form id="uploadForm" onsubmit="app.submitUpload(event)" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-300 mb-1">Название публикации *</label>
          <input 
            type="text" 
            id="mediaTitle" 
            required 
            maxlength="90"
            placeholder="Введите понятное название без мата и 18+" 
            class="w-full px-3.5 py-2.5 bg-[#161A26] border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-[#FF2E54]"
          >
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-300 mb-1">Описание (не обязательно)</label>
          <textarea 
            id="mediaDescription" 
            rows="3" 
            maxlength="500"
            placeholder="Расскажите о содержании материала..." 
            class="w-full px-3.5 py-2.5 bg-[#161A26] border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-[#FF2E54] resize-none"
          ></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-300 mb-1">Теги</label>
          <input 
            type="text" 
            id="mediaTags" 
            placeholder="спорт, природа, игры, музыка" 
            class="w-full px-3.5 py-2.5 bg-[#161A26] border border-white/10 rounded-xl text-sm text-white focus:outline-none focus:border-[#FF2E54]"
          >
        </div>

        <!-- Moderation Notice in Modal -->
        <div id="uploadAlert" class="hidden p-3 rounded-xl text-xs font-medium border"></div>

        <div class="flex items-center justify-between pt-2">
          <span class="text-[11px] text-gray-500 flex items-center gap-1">
            <i class="fa-solid fa-shield text-emerald-400"></i> Модерация активна
          </span>
          <div class="flex gap-2">
            <button 
              type="button" 
              onclick="app.closeUploadModal()" 
              class="px-4 py-2 bg-white/5 hover:bg-white/10 text-gray-300 rounded-xl text-xs font-semibold"
            >
              Отмена
            </button>
            <button 
              type="submit" 
              id="btnSubmitUpload"
              class="px-5 py-2.5 bg-[#FF2E54] hover:bg-[#e01c40] text-white rounded-xl text-xs font-bold transition shadow-lg shadow-red-500/25 flex items-center gap-2"
            >
              <i class="fa-solid fa-check"></i>
              Опубликовать
            </button>
          </div>
        </div>
      </form>

    </div>
  </div>

  <div id="authModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="bg-[#11141E] border border-white/15 w-full max-w-md rounded-2xl p-6 shadow-2xl relative text-center">
      
      <button onclick="app.closeAuthModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white p-2 text-lg">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="w-12 h-12 mx-auto rounded-2xl bg-[#FF2E54]/20 border border-[#FF2E54]/40 flex items-center justify-center text-xl text-[#FF2E54] mb-3">
        <i class="fa-solid fa-user-shield"></i>
      </div>

      <h2 class="text-lg font-bold text-white" id="authModalTitle">Регистрация / Вход</h2>
      <p class="text-xs text-gray-400 mt-1 mb-5">
        Введите никнейм. Имя проверяется на уникальность и отсутствие мата/пошлости.
      </p>

      <!-- Tab Switcher between Register and Switch User -->
      <div class="flex p-1 bg-[#080A0F] rounded-xl border border-white/5 mb-4 text-xs font-semibold">
        <button id="authTabRegister" onclick="app.switchAuthMode('register')" class="flex-1 py-1.5 rounded-lg bg-white/10 text-white transition">Новая регистрация</button>
        <button id="authTabLogin" onclick="app.switchAuthMode('login')" class="flex-1 py-1.5 rounded-lg text-gray-400 hover:text-white transition">Выбрать аккаунт</button>
      </div>

      <!-- Registration Form -->
      <form id="authRegisterForm" onsubmit="app.handleRegisterSubmit(event)" class="space-y-4 text-left">
        <div>
          <label class="block text-xs font-semibold text-gray-300 mb-1">Ваше уникальное имя (ник) *</label>
          <div class="relative">
            <span class="absolute left-3.5 top-2.5 text-gray-500 font-mono">@</span>
            <input 
              type="text" 
              id="authUsername" 
              required 
              maxlength="20"
              placeholder="artem_creator" 
              class="w-full pl-8 pr-4 py-2.5 bg-[#161A26] border border-white/15 rounded-xl text-sm text-white font-mono focus:outline-none focus:border-[#FF2E54]"
            >
          </div>
          <span class="text-[10px] text-gray-500 mt-1 block">От 3 до 20 знаков (буквы, цифры, _). Без мата и 18+.</span>
        </div>

        <div id="authAlert" class="hidden p-3 rounded-xl text-xs font-medium border"></div>

        <button 
          type="submit" 
          class="w-full py-2.5 bg-[#FF2E54] hover:bg-[#e01c40] text-white font-bold rounded-xl text-xs transition shadow-lg shadow-red-500/20"
        >
          Зарегистрировать аккаунт
        </button>
      </form>

      <!-- Account Switcher View -->
      <div id="authLoginForm" class="hidden text-left space-y-3">
        <label class="block text-xs font-semibold text-gray-300">Существующие авторы на устройстве:</label>
        <div id="existingUsersList" class="max-h-48 overflow-y-auto space-y-2 pr-1">
          <!-- Injected via JS -->
        </div>
      </div>

    </div>
  </div>

  <div id="mediaViewerModal" class="fixed inset-0 z-50 bg-black/95 backdrop-blur-lg hidden overflow-y-auto">
    <div class="min-h-screen flex flex-col justify-between max-w-6xl mx-auto p-3 sm:p-6 lg:p-8">
      
      <!-- Top Bar -->
      <div class="flex items-center justify-between pb-4 border-b border-white/10">
        <div class="flex items-center gap-3">
          <div id="viewerAuthorAvatar" class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-white uppercase text-sm border border-white/20"></div>
          <div>
            <h3 id="viewerTitle" class="text-base sm:text-lg font-bold text-white line-clamp-1">Заголовок материала</h3>
            <p id="viewerAuthorMeta" class="text-xs text-gray-400">@автор • дата</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="viewerDeleteBtn" onclick="app.deleteCurrentMedia()" title="Удалить мою публикацию" class="hidden px-3 py-1.5 rounded-xl bg-red-500/20 hover:bg-red-500/30 text-red-400 border border-red-500/30 text-xs font-semibold transition">
            <i class="fa-solid fa-trash-can mr-1"></i> Удалить
          </button>
          <button onclick="app.closeViewerModal()" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition">
            <i class="fa-solid fa-xmark text-lg"></i>
          </button>
        </div>
      </div>

      <!-- Main Stage -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 my-6 flex-1">
        
        <!-- Media Column -->
        <div class="lg:col-span-2 flex flex-col justify-center bg-black/70 rounded-2xl overflow-hidden border border-white/10 relative">
          <div id="viewerMediaContainer" class="w-full flex items-center justify-center min-h-[300px] max-h-[65vh] bg-black">
            <!-- Video or Image tag -->
          </div>

          <!-- Likes and Views stats -->
          <div class="p-4 bg-[#11141E] border-t border-white/5 flex flex-wrap items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <button id="viewerLikeBtn" onclick="app.toggleLikeCurrentMedia()" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold flex items-center gap-2 transition">
                <i class="fa-regular fa-thumbs-up text-sm"></i>
                <span id="viewerLikeCount">0</span>
              </button>
              <button onclick="app.copyShareLink()" class="px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold flex items-center gap-1.5 text-gray-300">
                <i class="fa-solid fa-share-nodes"></i>
                <span>Поделиться</span>
              </button>
            </div>
            <div class="text-xs text-gray-400 flex items-center gap-3">
              <span><i class="fa-regular fa-eye mr-1 text-gray-500"></i> <span id="viewerViews">0</span> просмотров</span>
              <span id="viewerDate" class="text-gray-500">Сегодня</span>
            </div>
          </div>

          <!-- Description and Tags -->
          <div class="p-4 bg-[#0d1017] text-xs text-gray-300 space-y-2 border-t border-white/5">
            <p id="viewerDescription" class="whitespace-pre-wrap text-gray-300"></p>
            <div id="viewerTags" class="flex flex-wrap gap-1.5 pt-1"></div>
          </div>
        </div>

        <!-- Comments Column -->
        <div class="bg-[#11141E] rounded-2xl border border-white/10 p-4 flex flex-col h-[520px] lg:h-auto">
          <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-3">
            <h4 class="font-bold text-sm text-white flex items-center gap-2">
              <i class="fa-regular fa-comments text-[#FF2E54]"></i>
              Комментарии (<span id="viewerCommentsCount">0</span>)
            </h4>
            <span class="text-[10px] text-gray-500 font-mono">Без ботов</span>
          </div>

          <!-- Comments Feed -->
          <div id="viewerCommentsList" class="flex-1 overflow-y-auto space-y-3 pr-1 text-xs">
            <!-- Dynamic comments -->
          </div>

          <!-- New Comment Input -->
          <form onsubmit="app.addComment(event)" class="mt-4 pt-3 border-t border-white/10">
            <div id="commentAuthPrompt" class="hidden mb-2 p-2 bg-yellow-500/10 border border-yellow-500/20 rounded-lg text-[11px] text-yellow-300 flex items-center justify-between">
