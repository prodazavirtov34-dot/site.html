  <script>
    /**
     * Strict Moderation Engine
     * Blocks profanity, slurs, explicit/porn/NSFW terms in Russian & English.
     */
    class ModerationFilter {
      constructor() {
        // Mat & Obscene roots in RU & EN
        this.profanityRoots = [
          'хуй', 'хуя', 'хуе', 'хуи', 'похуй', 'нахуй', 'охуе',
          'пизд', 'пезд',
          'ебат', 'ебан', 'ебут', 'ебли', 'заеб', 'выеб', 'еблан', 'ебок', 'съеб',
          'бляд', 'блят', 'бля',
          'мудак', 'мудил',
          'гондон', 'гандон',
          'сука', 'сучк', 'сучар',
          'дроч', 'дрочит', 'задрот',
          'fuck', 'fucker', 'fucking', 'bitch', 'asshole', 'dick', 'cunt', 'cock'
        ];

        // Porn, 18+, NSFW, and erotic keywords
        this.pornRoots = [
          'порно', 'порнух', 'порнуш', 'секс', 'хентай', 'hentai', 'эротик',
          'сиськи', 'сиськ', 'член', 'анал', 'кунилин', 'минет', 'blowjob',
          'porn', 'porno', 'nsfw', 'xxx', 'sex', 'boobs', 'nude', 'nudes',
          'vagina', 'penis', 'erotic', 'erotica', 'masturbat', 'эро'
        ];
      }

      /**
       * Clean and normalize string for deep inspection
       */
      normalize(text) {
        if (!text) return '';
        return text
          .toLowerCase()
          // replace leetspeak and Cyrillic/Latin lookalikes
          .replace(/[@]/g, 'а')
          .replace(/[0]/g, 'о')
          .replace(/[1!|]/g, 'и')
          .replace(/[3]/g, 'з')
          .replace(/[$]/g, 'с')
          .replace(/[a]/g, 'а')
          .replace(/[e]/g, 'е')
          .replace(/[o]/g, 'о')
          .replace(/[p]/g, 'р')
          .replace(/[c]/g, 'с')
          .replace(/[x]/g, 'х')
          .replace(/[^a-zа-яё0-9]/gi, ''); // strip spaces, punctuation
      }

      /**
       * Validate a string against profanity and porn filters
       * returns { valid: boolean, reason: string | null }
       */
      checkText(rawText) {
        if (!rawText || !rawText.trim()) return { valid: true };

        const normalized = this.normalize(rawText);
        const words = rawText.toLowerCase().split(/[\s,._\-?!/\\+*&^%$#@~`'":;()[\]{}<>]+/);

        // 1. Check porn roots
        for (const root of this.pornRoots) {
          if (normalized.includes(root)) {
            return {
              valid: false,
              reason: 'Материалы и термины сексуального или порнографического характера (18+) строго запрещены правилами магахоствидео.'
            };
          }
          for (const word of words) {
            if (word.includes(root)) {
              return {
                valid: false,
                reason: 'Обнаружены слова категории 18+/NSFW. Размещение такого контента запрещено.'
              };
            }
          }
        }

        // 2. Check profanity roots
        for (const root of this.profanityRoots) {
          if (normalized.includes(root)) {
            return {
              valid: false,
              reason: 'Обнаружена ненормативная лексика или мат. Пожалуйста, соблюдайте правила приличия.'
            };
          }
          for (const word of words) {
            if (word.startsWith(root) || word.includes(root)) {
              return {
                valid: false,
                reason: 'Использование мата и оскорблений запрещено на платформе.'
              };
            }
          }
        }

        return { valid: true };
      }

      /**
       * Check filename
       */
      checkFileName(fileName) {
        if (!fileName) return { valid: true };
        const check = this.checkText(fileName);
        if (!check.valid) {
          return {
            valid: false,
            reason: `Имя файла содержит запрещенные слова или 18+ маркеры. Переименуйте файл перед загрузкой!`
          };
        }
        return { valid: true };
      }
    }

    /**
     * IndexedDB Storage Adapter for large local videos and photos
     */
    class MagaDB {
      constructor() {
        this.dbName = 'MagaHostVideo_DB';
        this.version = 1;
        this.db = null;
      }

      async init() {
        return new Promise((resolve, reject) => {
          const req = indexedDB.open(this.dbName, this.version);
          req.onupgradeneeded = (e) => {
            const db = e.target.result;
            if (!db.objectStoreNames.contains('media')) {
              const store = db.createObjectStore('media', { keyPath: 'id' });
              store.createIndex('createdAt', 'createdAt', { unique: false });
              store.createIndex('author', 'author', { unique: false });
            }
          };
          req.onsuccess = (e) => {
            this.db = e.target.result;
            resolve(this.db);
          };
          req.onerror = (e) => reject(e);
        });
      }

      async getAllMedia() {
        return new Promise((resolve, reject) => {
          const tx = this.db.transaction('media', 'readonly');
          const store = tx.objectStore('media');
          const req = store.getAll();
          req.onsuccess = () => resolve(req.result || []);
          req.onerror = () => reject(req.error);
        });
      }

      async saveMedia(item) {
        return new Promise((resolve, reject) => {
          const tx = this.db.transaction('media', 'readwrite');
          const store = tx.objectStore('media');
          const req = store.put(item);
          req.onsuccess = () => resolve(true);
          req.onerror = () => reject(req.error);
        });
      }

      async deleteMedia(id) {
        return new Promise((resolve, reject) => {
          const tx = this.db.transaction('media', 'readwrite');
          const store = tx.objectStore('media');
          const req = store.delete(id);
          req.onsuccess = () => resolve(true);
          req.onerror = () => reject(req.error);
        });
      }
    }

    /**
     * Main Platform Controller
     */
    class MagaHostApp {
      constructor() {
        this.moderation = new ModerationFilter();
        this.db = new MagaDB();

        this.STORAGE_KEY_USERS = 'magahost_users_registry';
        this.STORAGE_KEY_CURRENT_USER = 'magahost_session_user';

        this.users = this.loadUsersRegistry();
        this.currentUser = this.loadCurrentUserSession();
        this.mediaList = [];

        this.currentFilter = 'all';
        this.searchQuery = '';
        this.selectedFile = null;
        this.selectedFileType = null;
        this.currentViewingId = null;

        this.authMode = 'register'; // 'register' or 'login'
        this.activeObjectUrls = [];

        this.boot();
      }

      async boot() {
        try {
          await this.db.init();
          this.mediaList = await this.db.getAllMedia();
          // Sort newest first
          this.mediaList.sort((a, b) => b.createdAt - a.createdAt);
        } catch (err) {
          console.error('IndexedDB init error:', err);
          this.mediaList = [];
        }

        this.renderUserHeader();
        this.renderFeed();
        this.updateStats();
        this.setupDragAndDrop();
      }

      loadUsersRegistry() {
        try {
          const raw = localStorage.getItem(this.STORAGE_KEY_USERS);
          if (raw) return JSON.parse(raw);
        } catch(e) {}
        return []; // Clean start, zero bots
      }

      saveUsersRegistry() {
        localStorage.setItem(this.STORAGE_KEY_USERS, JSON.stringify(this.users));
      }

      loadCurrentUserSession() {
        return localStorage.getItem(this.STORAGE_KEY_CURRENT_USER) || null;
      }

      setCurrentUserSession(username) {
        this.currentUser = username;
        if (username) {
          localStorage.setItem(this.STORAGE_KEY_CURRENT_USER, username);
        } else {
          localStorage.removeItem(this.STORAGE_KEY_CURRENT_USER);
        }
        this.renderUserHeader();
        this.renderFeed();
      }

      updateStats() {
        document.getElementById('statAuthorsCount').textContent = this.users.length;
        document.getElementById('statMediaCount').textContent = this.mediaList.length;
      }

      renderUserHeader() {
        const container = document.getElementById('userHeaderBlock');
        if (!container) return;

        if (this.currentUser) {
          container.innerHTML = `
            <div class="flex items-center gap-2.5 bg-[#161A26] border border-white/10 px-3 py-1.5 rounded-xl">
              <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-[#FF2E54] to-purple-600 text-white flex items-center justify-center font-bold text-xs uppercase shadow">
                ${this.currentUser.charAt(0)}
              </div>
              <div class="hidden sm:block text-left pr-1">
                <span class="text-xs font-bold text-white block leading-tight">@${this.escapeHtml(this.currentUser)}</span>
                <span class="text-[10px] text-emerald-400 font-mono">Авторизован</span>
              </div>
              <button onclick="app.logoutUser()" title="Сменить пользователя / Выйти" class="p-1.5 text-gray-400 hover:text-red-400 transition ml-1">
                <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
              </button>
            </div>
          `;
        } else {
          container.innerHTML = `
            <button 
              onclick="app.openAuthModal()" 
              class="flex items-center gap-2 px-3.5 py-2 bg-[#161A26] hover:bg-[#202535] border border-white/15 text-white font-semibold rounded-xl text-xs transition"
            >
              <i class="fa-solid fa-user text-[#FF2E54]"></i>
              <span>Вход / Регистрация</span>
            </button>
          `;
        }
      }

      openAuthModal() {
        const modal = document.getElementById('authModal');
        const alertBox = document.getElementById('authAlert');
        const input = document.getElementById('authUsername');
        alertBox.classList.add('hidden');
        input.value = '';
        this.switchAuthMode('register');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        setTimeout(() => input.focus(), 150);
      }

      closeAuthModal() {
        const modal = document.getElementById('authModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }

      switchAuthMode(mode) {
        this.authMode = mode;
        const regTab = document.getElementById('authTabRegister');
        const logTab = document.getElementById('authTabLogin');
        const regForm = document.getElementById('authRegisterForm');
        const logForm = document.getElementById('authLoginForm');
        const title = document.getElementById('authModalTitle');

        if (mode === 'register') {
          regTab.className = 'flex-1 py-1.5 rounded-lg bg-white/10 text-white transition';
          logTab.className = 'flex-1 py-1.5 rounded-lg text-gray-400 hover:text-white transition';
          regForm.classList.remove('hidden');
          logForm.classList.add('hidden');
          title.textContent = 'Новая регистрация';
        } else {
          logTab.className = 'flex-1 py-1.5 rounded-lg bg-white/10 text-white transition';
          regTab.className = 'flex-1 py-1.5 rounded-lg text-gray-400 hover:text-white transition';
          regForm.classList.add('hidden');
          logForm.classList.remove('hidden');
          title.textContent = 'Выбрать существующий аккаунт';
          this.renderExistingUsersList();
        }
      }

      renderExistingUsersList() {
        const list = document.getElementById('existingUsersList');
        if (this.users.length === 0) {
          list.innerHTML = `
            <div class="p-4 text-center text-xs text-gray-500 bg-[#080A0F] rounded-xl border border-white/5">
              На этом устройстве еще нет зарегистрированных авторов. Создайте первый ник во вкладке «Новая регистрация»!
            </div>
          `;
          return;
        }

        list.innerHTML = this.users.map(u => `
          <div class="flex items-center justify-between p-2.5 bg-[#161A26] rounded-xl border border-white/5 hover:border-[#FF2E54]/40 transition">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-lg bg-[#FF2E54]/20 text-[#FF2E54] flex items-center justify-center text-xs font-bold uppercase font-mono">
                ${u.charAt(0)}
              </div>
              <span class="text-xs font-semibold text-white">@${this.escapeHtml(u)}</span>
              ${u === this.currentUser ? '<span class="text-[10px] text-emerald-400 bg-emerald-500/10 px-1.5 py-0.2 rounded font-mono">Текущий</span>' : ''}
            </div>
            <button 
              type="button" 
              onclick="app.selectExistingUser('${u}')"
              class="px-3 py-1 bg-white/10 hover:bg-[#FF2E54] hover:text-white text-gray-300 rounded-lg text-xs font-semibold transition"
            >
              Войти
            </button>
          </div>
        `).join('');
      }

      selectExistingUser(username) {
        this.setCurrentUserSession(username);
        this.closeAuthModal();
        this.showToast(`Вы вошли как @${username}!`);
      }

      handleRegisterSubmit(e) {
        e.preventDefault();
        const input = document.getElementById('authUsername');
        const alertBox = document.getElementById('authAlert');
        const rawName = input.value.trim().toLowerCase();

        // 1. Length & format validation
        const regex = /^[a-zA-Z0-9_]{3,20}$/;
        if (!regex.test(rawName)) {
          this.setFormAlert(alertBox, 'Ник должен быть от 3 до 20 символов и содержать только буквы, цифры и символ _');
          return;
        }

        // 2. Strict Profanity and Porn check on Nickname
        const modCheck = this.moderation.checkText(rawName);
        if (!modCheck.valid) {
          this.setFormAlert(alertBox, `Недопустимый ник! ${modCheck.reason}`);
          return;
        }

        // 3. Strict Uniqueness Check
        if (this.users.includes(rawName)) {
          this.setFormAlert(alertBox, `Никнейм «@${rawName}» уже занят другим человеком! Второй раз зарегистрироваться под этим именем нельзя. Выберите другой ник или перейдите во вкладку «Выбрать аккаунт».`);
          return;
        }

        // Register new author
        this.users.push(rawName);
        this.saveUsersRegistry();
        this.setCurrentUserSession(rawName);
        this.updateStats();
        this.closeAuthModal();
        this.showToast(`Автор @${rawName} успешно зарегистрирован!`);
      }

      setFormAlert(el, message) {
        el.className = 'p-3 rounded-xl text-xs font-medium bg-red-500/10 border border-red-500/30 text-red-300 block leading-relaxed';
        el.innerHTML = `<i class="fa-solid fa-triangle-exclamation mr-1.5"></i> ${message}`;
      }

      logoutUser() {
        const prev = this.currentUser;
        this.setCurrentUserSession(null);
        this.showToast(`Сессия @${prev} завершена.`);
      }

      // Drag and drop for upload
      setupDragAndDrop() {
        const dropZone = document.getElementById('dropZone');
        if (!dropZone) return;

        ['dragenter', 'dragover'].forEach(name => {
          dropZone.addEventListener(name, (e) => {
            e.preventDefault();
            dropZone.classList.add('border-[#FF2E54]', 'bg-red-500/5');
          });
        });

        ['dragleave', 'drop'].forEach(name => {
          dropZone.addEventListener(name, (e) => {
            e.preventDefault();
            dropZone.classList.remove('border-[#FF2E54]', 'bg-red-500/5');
          });
        });

        dropZone.addEventListener('drop', (e) => {
          const files = e.dataTransfer.files;
          if (files.length > 0) this.processFile(files[0]);
        });
      }

      openUploadModal() {
        if (!this.currentUser) {
          this.openAuthModal();
          const alertBox = document.getElementById('authAlert');
          this.setFormAlert(alertBox, 'Чтобы загружать фото или видео на магахоствидео, необходимо зарегистрироваться или выбрать свой профиль!');
          return;
        }

        const modal = document.getElementById('uploadModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        this.clearSelectedFile();
      }

      closeUploadModal() {
        const modal = document.getElementById('uploadModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }

      handleFileSelect(e) {
        const file = e.target.files[0];
        if (file) this.processFile(file);
      }

      processFile(file) {
        const alertBox = document.getElementById('uploadAlert');
        alertBox.classList.add('hidden');

        // Check filename with anti-porn & anti-mat
        const nameCheck = this.moderation.checkFileName(file.name);
        if (!nameCheck.valid) {
          this.setFormAlert(alertBox, nameCheck.reason);
          this.clearSelectedFile();
          return;
        }

        const isVideo = file.type.startsWith('video/');
        const isImage = file.type.startsWith('image/');

        if (!isVideo && !isImage) {
          this.setFormAlert(alertBox, 'Разрешены только видео (MP4, WebM) и фотографии (JPG, PNG, GIF, WebP)!');
          return;
        }

        this.selectedFile = file;
        this.selectedFileType = isVideo ? 'video' : 'image';

        const prompt = document.getElementById('uploadPrompt');
        const previewZone = document.getElementById('uploadPreviewZone');
        const imgPrev = document.getElementById('imagePreview');
        const vidPrev = document.getElementById('videoPreview');

        prompt.classList.add('hidden');
        previewZone.classList.remove('hidden');

        const objectUrl = URL.createObjectURL(file);
        this.activeObjectUrls.push(objectUrl);

        if (isVideo) {
          imgPrev.classList.add('hidden');
          vidPrev.classList.remove('hidden');
          vidPrev.src = objectUrl;
        } else {
          vidPrev.classList.add('hidden');
          imgPrev.classList.remove('hidden');
          imgPrev.src = objectUrl;
        }

        const titleInput = document.getElementById('mediaTitle');
        if (!titleInput.value) {
          const cleanName = file.name.substring(0, file.name.lastIndexOf('.')) || file.name;
          titleInput.value = cleanName.replace(/[_-]/g, ' ');
        }
      }

      clearSelectedFile() {
        this.selectedFile = null;
        this.selectedFileType = null;
        document.getElementById('fileInput').value = '';
        document.getElementById('uploadPrompt').classList.remove('hidden');
        document.getElementById('uploadPreviewZone').classList.add('hidden');
        document.getElementById('imagePreview').src = '';
        document.getElementById('videoPreview').src = '';
      }

      async submitUpload(e) {
        e.preventDefault();
        const alertBox = document.getElementById('uploadAlert');
        alertBox.classList.add('hidden');

        if (!this.selectedFile) {
          this.setFormAlert(alertBox, 'Пожалуйста, выберите файл с диска!');
          return;
        }

        const title = document.getElementById('mediaTitle').value.trim();
        const description = document.getElementById('mediaDescription').value.trim();
        const rawTags = document.getElementById('mediaTags').value;

        // 1. Strict anti-mat & anti-porn filter on Title
        const titleCheck = this.moderation.checkText(title);
        if (!titleCheck.valid) {
          this.setFormAlert(alertBox, `Название отклонено: ${titleCheck.reason}`);
          return;
        }

        // 2. Strict filter on Description
        if (description) {
          const descCheck = this.moderation.checkText(description);
          if (!descCheck.valid) {
            this.setFormAlert(alertBox, `Описание отклонено: ${descCheck.reason}`);
            return;
          }
        }

        // 3. Strict filter on Tags
        const tags = rawTags.split(/[\s,]+/).filter(t => t.length > 0).map(t => t.replace(/^#/, ''));
        for (const t of tags) {
          const tCheck = this.moderation.checkText(t);
          if (!tCheck.valid) {
            this.setFormAlert(alertBox, `Тег #${t} отклонен цензурой: ${tCheck.reason}`);
            return;
          }
        }

        // Read file into Blob for IndexedDB persistent storage
        const fileBlob = this.selectedFile;
        const mediaId = 'media-' + Date.now();

        const newMediaItem = {
          id: mediaId,
          title: title,
          description: description,
          type: this.selectedFileType,
          blob: fileBlob,
          author: this.currentUser,
          createdAt: Date.now(),
          views: 0,
          likes: 0,
          likedBy: [],
          tags: tags.length > 0 ? tags : ['магахост'],
          comments: []
        };

        try {
          await this.db.saveMedia(newMediaItem);
          this.mediaList.unshift(newMediaItem);
          this.updateStats();
          this.renderFeed();

          document.getElementById('uploadForm').reset();
          this.clearSelectedFile();
          this.closeUploadModal();
          this.showToast('Файл успешно загружен и сохранен в базе!');
        } catch (err) {
          console.error(err);
          this.setFormAlert(alertBox, 'Ошибка при записи в память IndexedDB.');
        }
      }

      setFilter(name) {
        this.currentFilter = name;
        ['all', 'video', 'image', 'my'].forEach(k => {
          const btn = document.getElementById(`filter-${k}`);
          if (!btn) return;
          if (k === name) {
            btn.className = 'category-btn px-4 py-2 rounded-xl text-xs font-semibold bg-white text-black transition-all whitespace-nowrap shadow';
          } else {
            btn.className = 'category-btn px-4 py-2 rounded-xl text-xs font-semibold bg-[#161A26] hover:bg-[#1d2233] text-gray-300 border border-white/5 transition-all whitespace-nowrap';
          }
        });
        this.renderFeed();
      }

      resetFeedFilter() {
        this.clearSearch();
        this.setFilter('all');
      }

      handleSearch(val) {
        this.searchQuery = val.toLowerCase().trim();
        const clearBtn = document.getElementById('clearSearchBtn');
        if (clearBtn) clearBtn.classList.toggle('hidden', this.searchQuery === '');
        this.renderFeed();
      }

      clearSearch() {
        this.searchQuery = '';
        const input = document.getElementById('searchInput');
        if (input) input.value = '';
        const clearBtn = document.getElementById('clearSearchBtn');
        if (clearBtn) clearBtn.classList.add('hidden');
        this.renderFeed();
      }

      getFilteredMedia() {
        let list = [...this.mediaList];

        if (this.searchQuery) {
          list = list.filter(item => {
            const inTitle = item.title.toLowerCase().includes(this.searchQuery);
            const inAuthor = item.author.toLowerCase().includes(this.searchQuery);
            const inDesc = item.description?.toLowerCase().includes(this.searchQuery);
            const inTags = item.tags?.some(tag => tag.toLowerCase().includes(this.searchQuery));
            return inTitle || inAuthor || inDesc || inTags;
          });
        }

        if (this.currentFilter === 'video') {
          list = list.filter(i => i.type === 'video');
        } else if (this.currentFilter === 'image') {
          list = list.filter(i => i.type === 'image');
        } else if (this.currentFilter === 'my') {
          if (!this.currentUser) return [];
          list = list.filter(i => i.author === this.currentUser);
        }

        return list;
      }

      renderFeed() {
        const grid = document.getElementById('mediaFeedGrid');
        const empty = document.getElementById('emptyState');
        const items = this.getFilteredMedia();

        if (items.length === 0) {
          grid.innerHTML = '';
          empty.classList.remove('hidden');
          empty.classList.add('flex');
          return;
        }

        empty.classList.add('hidden');
        empty.classList.remove('flex');

        grid.innerHTML = items.map(item => this.createCardHtml(item)).join('');
      }

      createCardHtml(item) {
        const isVideo = item.type === 'video';
        const formattedDate = this.formatRelativeTime(item.createdAt);
        const userAvatarLetter = item.author.charAt(0).toUpperCase();

        // Create temporary blob URL for feed thumbnail
        const blobUrl = URL.createObjectURL(item.blob);
        this.activeObjectUrls.push(blobUrl);

        return `
          <div 
            class="group bg-[#11141E] border border-white/10 hover:border-[#FF2E54]/50 rounded-2xl overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-red-500/5 cursor-pointer flex flex-col"
            onclick="app.openViewerModal('${item.id}')"
          >
            <div class="relative bg-black media-card-aspect overflow-hidden flex items-center justify-center">
              ${isVideo ? `
                <video src="${blobUrl}#t=0.5" preload="metadata" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"></video>
                <div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                  <div class="w-12 h-12 rounded-full bg-black/60 backdrop-blur-md border border-white/20 text-white flex items-center justify-center pl-0.5 group-hover:scale-110 group-hover:bg-[#FF2E54] transition shadow-lg">
                    <i class="fa-solid fa-play text-sm"></i>
                  </div>
                </div>
                <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded-md bg-black/80 font-mono text-[10px] text-white font-bold flex items-center gap-1 border border-white/10">
                  <i class="fa-solid fa-video text-[9px] text-[#FF2E54]"></i> ВИДЕО
                </span>
              ` : `
                <img src="${blobUrl}" alt="${this.escapeHtml(item.title)}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                <span class="absolute bottom-2.5 right-2.5 px-2 py-0.5 rounded-md bg-black/80 font-mono text-[10px] text-white font-bold flex items-center gap-1 border border-white/10">
                  <i class="fa-solid fa-image text-[9px] text-emerald-400"></i> ФОТО
                </span>
              `}
            </div>

            <div class="p-4 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="font-bold text-sm text-white group-hover:text-[#FF2E54] transition line-clamp-2 leading-snug">
                  ${this.escapeHtml(item.title)}
                </h3>
                
                <div class="flex items-center gap-2 mt-3">
                  <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-[#FF2E54] to-purple-600 flex items-center justify-center text-[10px] font-bold text-white uppercase flex-shrink-0">
                    ${userAvatarLetter}
                  </div>
                  <span class="text-xs text-gray-300 font-medium truncate">@${this.escapeHtml(item.author)}</span>
                </div>
              </div>

              <div class="pt-3 mt-3 border-t border-white/5 flex items-center justify-between text-[11px] text-gray-400 font-mono">
                <span class="flex items-center gap-1.5"><i class="fa-regular fa-eye"></i> ${item.views}</span>
                <span class="flex items-center gap-1.5"><i class="fa-regular fa-thumbs-up"></i> ${item.likes}</span>
                <span class="flex items-center gap-1.5"><i class="fa-regular fa-comment"></i> ${item.comments ? item.comments.length : 0}</span>
                <span class="text-gray-500 text-[10px]">${formattedDate}</span>
              </div>
            </div>
          </div>
        `;
      }

      async openViewerModal(id) {
        const item = this.mediaList.find(m => m.id === id);
        if (!item) return;

        this.currentViewingId = id;
        item.views = (item.views || 0) + 1;
        await this.db.saveMedia(item);

        const modal = document.getElementById('mediaViewerModal');
        const container = document.getElementById('viewerMediaContainer');
        const title = document.getElementById('viewerTitle');
        const authorMeta = document.getElementById('viewerAuthorMeta');
        const authorAvatar = document.getElementById('viewerAuthorAvatar');
        const desc = document.getElementById('viewerDescription');
        const tags = document.getElementById('viewerTags');
        const views = document.getElementById('viewerViews');
        const date = document.getElementById('viewerDate');
        const likeCount = document.getElementById('viewerLikeCount');
        const deleteBtn = document.getElementById('viewerDeleteBtn');

        title.textContent = item.title;
        authorMeta.textContent = `@${item.author} • ${this.formatRelativeTime(item.createdAt)}`;
        authorAvatar.textContent = item.author.charAt(0).toUpperCase();
        authorAvatar.className = 'w-10 h-10 rounded-full flex items-center justify-center font-bold text-white uppercase text-sm bg-gradient-to-tr from-[#FF2E54] to-purple-600';
        
        desc.textContent = item.description || 'Описание отсутствует.';
        views.textContent = item.views;
        date.textContent = new Date(item.createdAt).toLocaleDateString('ru-RU');
        likeCount.textContent = item.likes || 0;

        // Delete button visible only to author
        if (this.currentUser && this.currentUser === item.author) {
          deleteBtn.classList.remove('hidden');
        } else {
          deleteBtn.classList.add('hidden');
        }

        tags.innerHTML = (item.tags || []).map(t => `
          <span class="px-2 py-0.5 rounded-md bg-white/5 text-[11px] text-gray-400 font-mono">#${this.escapeHtml(t)}</span>
        `).join('');

        const objectUrl = URL.createObjectURL(item.blob);
        this.activeObjectUrls.push(objectUrl);

        if (item.type === 'video') {
          container.innerHTML = `
            <video 
              id="activeVideoPlayer" 
              src="${objectUrl}" 
              controls 
              autoplay 
              class="w-full max-h-[60vh] object-contain bg-black outline-none"
            ></video>
          `;
        } else {
          container.innerHTML = `
            <img 
              src="${objectUrl}" 
              class="max-h-[60vh] w-auto max-w-full object-contain mx-auto rounded-lg shadow-2xl" 
            />
          `;
        }

        this.renderViewerComments(item);
        this.updateLikeButtonState(item);

        const authPrompt = document.getElementById('commentAuthPrompt');
        authPrompt.classList.toggle('hidden', !!this.currentUser);

        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }

      closeViewerModal() {
        const modal = document.getElementById('mediaViewerModal');
        const container = document.getElementById('viewerMediaContainer');
        const video = document.getElementById('activeVideoPlayer');
        if (video) video.pause();
        container.innerHTML = '';
        modal.classList.add('hidden');
        document.body.style.overflow = 'auto';
        this.currentViewingId = null;
        this.renderFeed();
      }

      async deleteCurrentMedia() {
        const item = this.mediaList.find(m => m.id === this.currentViewingId);
        if (!item) return;

        if (this.currentUser !== item.author) {
          this.showToast('Вы можете удалять только свои публикации!', 'error');
          return;
        }

        await this.db.deleteMedia(item.id);
        this.mediaList = this.mediaList.filter(m => m.id !== item.id);
        this.updateStats();
        this.closeViewerModal();
        this.showToast('Публикация удалена из базы.');
      }

      async toggleLikeCurrentMedia() {
        if (!this.currentUser) {
          this.showToast('Зарегистрируйтесь или войдите, чтобы ставить лайки!', 'info');
          this.openAuthModal();
          return;
        }

        const item = this.mediaList.find(m => m.id === this.currentViewingId);
        if (!item) return;

        if (!item.likedBy) item.likedBy = [];

        const hasLiked = item.likedBy.includes(this.currentUser);
        if (hasLiked) {
          item.likedBy = item.likedBy.filter(u => u !== this.currentUser);
          item.likes = Math.max(0, item.likes - 1);
        } else {
          item.likedBy.push(this.currentUser);
          item.likes = (item.likes || 0) + 1;
        }

        await this.db.saveMedia(item);
        document.getElementById('viewerLikeCount').textContent = item.likes;
        this.updateLikeButtonState(item);
      }

      updateLikeButtonState(item) {
        const likeBtn = document.getElementById('viewerLikeBtn');
        const hasLiked = this.currentUser && item.likedBy?.includes(this.currentUser);

        if (hasLiked) {
          likeBtn.className = 'px-4 py-2 rounded-xl bg-[#FF2E54] text-white text-xs font-semibold flex items-center gap-2 shadow-lg shadow-red-500/25 transition';
        } else {
          likeBtn.className = 'px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-gray-300 text-xs font-semibold flex items-center gap-2 transition';
        }
      }

      renderViewerComments(item) {
        const countSpan = document.getElementById('viewerCommentsCount');
        const list = document.getElementById('viewerCommentsList');
        const comments = item.comments || [];

        countSpan.textContent = comments.length;

        if (comments.length === 0) {
          list.innerHTML = `
            <div class="h-44 flex flex-col items-center justify-center text-gray-500 text-center">
              <i class="fa-regular fa-comments text-2xl mb-2 text-gray-600"></i>
              <p>Комментариев пока нет.</p>
              <p class="text-[11px] text-gray-600 mt-0.5">Оставьте первое мнение без мата и спама!</p>
            </div>
          `;
          return;
        }

        list.innerHTML = comments.slice().reverse().map(c => `
          <div class="bg-[#161A26] p-3 rounded-xl border border-white/5 space-y-1">
            <div class="flex items-center justify-between">
              <span class="font-bold text-white text-[11px] flex items-center gap-1.5">
                <span class="w-4 h-4 rounded-full bg-[#FF2E54]/30 text-[#FF2E54] text-[9px] flex items-center justify-center uppercase font-mono">${c.author.charAt(0)}</span>
                @${this.escapeHtml(c.author)}
              </span>
              <span class="text-[10px] text-gray-500 font-mono">${this.formatRelativeTime(c.time)}</span>
            </div>
            <p class="text-xs text-gray-300 leading-relaxed break-words">${this.escapeHtml(c.text)}</p>
          </div>
        `).join('');
      }

      async addComment(e) {
        e.preventDefault();
        if (!this.currentUser) {
          this.openAuthModal();
          this.showToast('Войдите под своим ником, чтобы комментировать!', 'info');
          return;
        }

        const input = document.getElementById('commentInput');
        const rawText = input.value.trim();
        if (!rawText) return;

        // Anti-mat & anti-porn filter for comments
        const modCheck = this.moderation.checkText(rawText);
        if (!modCheck.valid) {
          this.showToast(modCheck.reason, 'error');
          return;
        }

        const item = this.mediaList.find(m => m.id === this.currentViewingId);
        if (!item) return;

        if (!item.comments) item.comments = [];

        item.comments.push({
          id: 'c-' + Date.now(),
          author: this.currentUser,
          text: rawText,
          time: Date.now()
        });

        await this.db.saveMedia(item);
        input.value = '';
        this.renderViewerComments(item);
        this.showToast('Комментарий успешно опубликован!');
      }

      copyShareLink() {
        const temp = document.createElement('input');
        temp.value = window.location.href;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        document.body.removeChild(temp);
        this.showToast('Ссылка скопирована!');
      }

      showToast(message, type = 'default') {
        const toast = document.getElementById('customToast');
        const msg = document.getElementById('toastMessage');
        const icon = document.getElementById('toastIcon');

        msg.textContent = message;
        if (type === 'error') {
          icon.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-red-400"></i>';
          icon.className = 'w-7 h-7 rounded-lg bg-red-500/20 flex items-center justify-center text-sm';
        } else if (type === 'info') {
          icon.innerHTML = '<i class="fa-solid fa-circle-info text-yellow-400"></i>';
          icon.className = 'w-7 h-7 rounded-lg bg-yellow-500/20 flex items-center justify-center text-sm';
        } else {
          icon.innerHTML = '<i class="fa-solid fa-check text-emerald-400"></i>';
          icon.className = 'w-7 h-7 rounded-lg bg-emerald-500/20 flex items-center justify-center text-sm';
        }

        toast.classList.remove('translate-y-24', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');

        setTimeout(() => {
          toast.classList.add('translate-y-24', 'opacity-0');
          toast.classList.remove('translate-y-0', 'opacity-100');
        }, 3600);
      }

      formatRelativeTime(timestamp) {
        const diff = Math.floor((Date.now() - timestamp) / 1000);
        if (diff < 60) return 'только что';
        if (diff < 3600) return `${Math.floor(diff / 60)} мин. назад`;
        if (diff < 86400) return `${Math.floor(diff / 3600)} ч. назад`;
        return `${Math.floor(diff / 86400)} дн. назад`;
      }

      escapeHtml(str) {
        if (!str) return '';
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }
    }

    // Initialize application instance
    const app = new MagaHostApp();
  </script>
</body>
